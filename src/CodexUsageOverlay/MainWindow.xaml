<Window x:Class="CodexUsageOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Codex Usage Overlay"
        Width="34"
        Height="190"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Loaded="Window_OnLoaded"
        Closed="Window_OnClosed"
        SourceInitialized="Window_OnSourceInitialized">
    <Grid x:Name="OverlayRoot"
          Width="254"
          HorizontalAlignment="Right"
          MouseEnter="OverlayRoot_OnMouseEnter"
          MouseLeave="OverlayRoot_OnMouseLeave">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="34" />
        </Grid.ColumnDefinitions>

        <Border x:Name="DetailsPanel"
                Grid.Column="0"
                Margin="0,12,12,12"
                Padding="14"
                VerticalAlignment="Center"
                Background="{StaticResource OverlaySurfaceBrush}"
                BorderBrush="{StaticResource OverlayBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Opacity="0"
                Visibility="Collapsed">
            <Border.RenderTransform>
                <TranslateTransform x:Name="DetailsTranslate" X="8" />
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Codex usage"
                               Foreground="{StaticResource OverlayTextBrush}"
                               FontSize="{StaticResource OverlayTextBody}"
                               FontWeight="Medium" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="LiveDot" Width="6" Height="6" Margin="0,0,5,0" Fill="#FF55C878" />
                        <TextBlock x:Name="StatusText"
                                   Text="Connecting"
                                   Foreground="{StaticResource OverlayMutedBrush}"
                                   FontSize="{StaticResource OverlayTextSmall}" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1" Margin="0,13,0,0">
                    <TextBlock x:Name="BucketNameText"
                               Text="Usage remaining"
                               Foreground="{StaticResource OverlayMutedBrush}"
                               FontSize="{StaticResource OverlayTextSmall}" />
                    <TextBlock x:Name="UsagePercentText"
                               Margin="0,2,0,0"
                               Text="Checking..."
                               Foreground="{StaticResource OverlayTextBrush}"
                               FontSize="{StaticResource OverlayTextValue}"
                               FontWeight="Medium" />
                    <TextBlock x:Name="ResetText"
                               Margin="0,3,0,0"
                               Text="Waiting for usage data"
                               Foreground="{StaticResource OverlayMutedBrush}"
                               FontSize="{StaticResource OverlayTextSmall}" />
                </StackPanel>

                <Border Grid.Row="2" Margin="0,12,0,0" Height="1" Background="{StaticResource OverlayBorderBrush}" />

                <Grid Grid.Row="3" Margin="0,10,0,0">
                    <TextBlock x:Name="AdditionalBucketText"
                               Text="No additional limits"
                               Foreground="{StaticResource OverlayMutedBrush}"
                               FontSize="{StaticResource OverlayTextSmall}"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Column="1"
              x:Name="RailHitTarget"
              Width="34"
              Background="#01000000"
              Cursor="Hand"
              AutomationProperties.Name="Codex usage meter"
              MouseLeftButtonDown="RailHitTarget_OnMouseLeftButtonDown">
            <Grid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Refresh now" Click="RefreshMenuItem_OnClick" />
                    <Separator />
                    <MenuItem Header="Exit" Click="ExitMenuItem_OnClick" />
                </ContextMenu>
            </Grid.ContextMenu>

            <StackPanel Width="34" Margin="0,0,0,5" VerticalAlignment="Bottom">
                <Grid Width="14" Height="138" HorizontalAlignment="Center">
                    <Border Background="{StaticResource OverlayTrackBrush}"
                            BorderBrush="{StaticResource OverlayBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="7" />
                    <Border x:Name="UsageFill"
                            Margin="2"
                            CornerRadius="5"
                            RenderTransformOrigin="0.5,1">
                        <Border.Background>
                            <SolidColorBrush x:Name="UsageFillBrush" Color="{StaticResource OverlayNormalColor}" />
                        </Border.Background>
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="UsageFillScale" ScaleY="0" />
                        </Border.RenderTransform>
                    </Border>
                    <Border x:Name="LeadingCap"
                            Width="8"
                            Height="2"
                            VerticalAlignment="Bottom"
                            Background="#FFF2FFF5"
                            CornerRadius="1"
                            Opacity="0"
                            RenderTransformOrigin="0.5,1">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="LeadingCapTranslate" Y="0" />
                        </Border.RenderTransform>
                    </Border>
                </Grid>
                <TextBlock x:Name="RailRemainingText"
                           Margin="0,4,0,0"
                           HorizontalAlignment="Center"
                           Text="--"
                           TextAlignment="Center"
                           Foreground="{StaticResource OverlayMutedBrush}"
                           FontSize="{StaticResource OverlayTextSmall}"
                           FontWeight="Medium" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
