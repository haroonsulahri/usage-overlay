<Application x:Class="UsageOverlay.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <Application.Resources>
        <Color x:Key="OverlaySurfaceColor">#FF242424</Color>
        <Color x:Key="OverlaySurfaceRaisedColor">#FF2A2A2A</Color>
        <Color x:Key="OverlayBorderColor">#FF3B3B3B</Color>
        <Color x:Key="OverlayTextColor">#FFF2F2F2</Color>
        <Color x:Key="OverlayMutedColor">#FFA0A0A0</Color>
        <Color x:Key="OverlayTrackColor">#FF353535</Color>
        <Color x:Key="OverlayNormalColor">#FF55C878</Color>
        <Color x:Key="OverlayWarningColor">#FFF0B45E</Color>
        <Color x:Key="OverlayCriticalColor">#FFE55A5A</Color>
        <Color x:Key="OverlayMenuHoverColor">#FF333333</Color>
        <Color x:Key="OverlayMenuCriticalHoverColor">#FF3B2929</Color>
        <Color x:Key="SettingsPrimaryTextColor">#FF102419</Color>

        <SolidColorBrush x:Key="OverlaySurfaceBrush" Color="{StaticResource OverlaySurfaceColor}" />
        <SolidColorBrush x:Key="OverlaySurfaceRaisedBrush" Color="{StaticResource OverlaySurfaceRaisedColor}" />
        <SolidColorBrush x:Key="OverlayBorderBrush" Color="{StaticResource OverlayBorderColor}" />
        <SolidColorBrush x:Key="OverlayTextBrush" Color="{StaticResource OverlayTextColor}" />
        <SolidColorBrush x:Key="OverlayMutedBrush" Color="{StaticResource OverlayMutedColor}" />
        <SolidColorBrush x:Key="OverlayTrackBrush" Color="{StaticResource OverlayTrackColor}" />
        <SolidColorBrush x:Key="OverlayMenuHoverBrush" Color="{StaticResource OverlayMenuHoverColor}" />
        <SolidColorBrush x:Key="OverlayMenuCriticalHoverBrush" Color="{StaticResource OverlayMenuCriticalHoverColor}" />
        <SolidColorBrush x:Key="OverlayCriticalBrush" Color="{StaticResource OverlayCriticalColor}" />
        <SolidColorBrush x:Key="SettingsPrimaryTextBrush" Color="{StaticResource SettingsPrimaryTextColor}" />

        <sys:Double x:Key="OverlayTextSmall">11</sys:Double>
        <sys:Double x:Key="OverlayTextBody">13</sys:Double>
        <sys:Double x:Key="OverlayTextValue">18</sys:Double>

        <Style x:Key="OverlayContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="MinWidth" Value="174" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="0" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{DynamicResource OverlayBorderBrush}"
                                CornerRadius="12"
                                Padding="1"
                                SnapsToDevicePixels="True">
                            <Border Background="{DynamicResource OverlaySurfaceBrush}"
                                    CornerRadius="11"
                                    Padding="5">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="ContextMenu.Opened">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0"
                                             To="1"
                                             Duration="0:0:0.16">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                             From="4"
                                             To="0"
                                             Duration="0:0:0.16">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OverlayMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource OverlayTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="{StaticResource OverlayTextBody}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Padding" Value="11,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemSurface"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemSurface"
                                        Property="Background"
                                        Value="{DynamicResource OverlayMenuHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource OverlayMutedBrush}" />
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Destructive">
                                <Setter Property="Foreground" Value="{DynamicResource OverlayCriticalBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsHighlighted" Value="True" />
                                    <Condition Property="Tag" Value="Destructive" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ItemSurface"
                                        Property="Background"
                                        Value="{DynamicResource OverlayMenuCriticalHoverBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OverlayMenuSeparatorStyle" TargetType="Separator">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="8,4" />
            <Setter Property="Background" Value="{DynamicResource OverlayBorderBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OverlayIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="IconSurface"
                                Width="24"
                                Height="24"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IconSurface" Property="Background" Value="{DynamicResource OverlayMenuHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="IconSurface" Property="Background" Value="{DynamicResource SettingsButtonPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="IconSurface" Property="BorderBrush" Value="{DynamicResource OverlayBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
