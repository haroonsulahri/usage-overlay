<Window x:Class="UsageOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Usage Overlay"
        Width="34"
        Height="190"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Loaded="Window_OnLoaded"
        Closed="Window_OnClosed"
        SourceInitialized="Window_OnSourceInitialized">
    <Grid x:Name="OverlayRoot"
          Width="254"
          HorizontalAlignment="Right"
          MouseEnter="OverlayRoot_OnMouseEnter"
          MouseLeave="OverlayRoot_OnMouseLeave">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="34" />
        </Grid.ColumnDefinitions>

        <Border x:Name="DetailsPanel"
                Grid.Column="0"
                Margin="0,12,12,12"
                Padding="14"
                VerticalAlignment="Center"
                Background="{DynamicResource OverlaySurfaceBrush}"
                BorderBrush="{DynamicResource OverlayBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Opacity="0"
                Visibility="Collapsed">
            <Border.RenderTransform>
                <TranslateTransform x:Name="DetailsTranslate" X="8" Y="24" />
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Height="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Codex usage"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource OverlayTextBrush}"
                               FontSize="{StaticResource OverlayTextBody}"
                               FontWeight="Medium" />
                    <StackPanel Grid.Column="1"
                                Margin="0,0,10,0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Ellipse x:Name="LiveDot" Width="6" Height="6" Margin="0,0,5,0" Fill="{DynamicResource OverlayNormalBrush}" />
                        <TextBlock x:Name="StatusText"
                                   Text="Connecting…"
                                   Foreground="{DynamicResource OverlayMutedBrush}"
                                   FontSize="{StaticResource OverlayTextSmall}" />
                    </StackPanel>
                    <Button Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{StaticResource OverlayIconButtonStyle}"
                            AutomationProperties.Name="Close usage details"
                            ToolTip="Close usage details"
                            Click="CloseUsageDetailsButton_OnClick">
                        <Path Width="10"
                              Height="10"
                              Data="M 0,0 L 10,10 M 10,0 L 0,10"
                              Stretch="Fill"
                              Stroke="{DynamicResource OverlayMutedBrush}"
                              StrokeThickness="1.25"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                    </Button>
                </Grid>

                <StackPanel Grid.Row="1" Margin="0,13,0,0">
                    <TextBlock x:Name="BucketNameText"
                               Text="Codex usage"
                               Foreground="{DynamicResource OverlayMutedBrush}"
                               FontSize="{StaticResource OverlayTextSmall}" />
                    <TextBlock x:Name="UsagePercentText"
                               Margin="0,2,0,0"
                               Text="Loading usage…"
                               Foreground="{DynamicResource OverlayTextBrush}"
                               FontSize="{StaticResource OverlayTextValue}"
                               FontWeight="Medium" />
                    <TextBlock x:Name="ResetText"
                               Margin="0,3,0,0"
                               Text="Connecting to Codex…"
                               Foreground="{DynamicResource OverlayMutedBrush}"
                               FontSize="{StaticResource OverlayTextSmall}" />
                    <StackPanel x:Name="AdditionalLimitsPanel" />
                    <Border Margin="0,10,0,0"
                            Padding="0,9,0,0"
                            BorderBrush="{DynamicResource OverlayBorderBrush}"
                            BorderThickness="0,1,0,0">
                        <Button HorizontalAlignment="Right"
                                Padding="2,0"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                FontSize="{StaticResource OverlayTextSmall}"
                                AutomationProperties.Name="View full Codex usage"
                                ToolTip="Open full Codex usage"
                                Click="ViewUsageLink_OnClick">
                            <Button.Foreground>
                                <SolidColorBrush Color="{StaticResource OverlayNormalColor}" />
                            </Button.Foreground>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <TextBlock x:Name="LinkText"
                                               Padding="{TemplateBinding Padding}"
                                               Text="{TemplateBinding Content}"
                                               Foreground="{TemplateBinding Foreground}"
                                               TextDecorations="Underline" />
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="LinkText" Property="Opacity" Value="0.78" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            View usage
                        </Button>
                    </Border>
                </StackPanel>

            </Grid>
        </Border>

        <Grid Grid.Column="1"
              x:Name="RailHitTarget"
              Width="34"
              Background="#01000000"
              Cursor="SizeAll"
              AutomationProperties.Name="Usage Overlay meter"
              MouseLeftButtonDown="RailHitTarget_OnMouseLeftButtonDown"
              MouseLeftButtonUp="RailHitTarget_OnMouseLeftButtonUp"
              MouseMove="RailHitTarget_OnMouseMove"
              LostMouseCapture="RailHitTarget_OnLostMouseCapture">
            <Grid.ContextMenu>
                <ContextMenu Style="{StaticResource OverlayContextMenuStyle}">
                    <MenuItem x:Name="RailVisibilityMenuItem"
                              Header="Hide usage rail"
                              Style="{StaticResource OverlayMenuItemStyle}"
                              Click="VisibilityMenuItem_OnClick" />
                    <Separator Style="{StaticResource OverlayMenuSeparatorStyle}" />
                    <MenuItem Header="Open settings…"
                              Style="{StaticResource OverlayMenuItemStyle}"
                              Click="SettingsMenuItem_OnClick" />
                    <Separator Style="{StaticResource OverlayMenuSeparatorStyle}" />
                    <MenuItem Header="Refresh usage"
                              Style="{StaticResource OverlayMenuItemStyle}"
                              Click="RefreshMenuItem_OnClick" />
                    <MenuItem x:Name="ConnectionMenuItem"
                              Header="Disconnect Codex CLI"
                              Style="{StaticResource OverlayMenuItemStyle}"
                              Click="ConnectionMenuItem_OnClick" />
                    <MenuItem Header="Check for updates"
                              Style="{StaticResource OverlayMenuItemStyle}"
                              Click="CheckForUpdatesMenuItem_OnClick" />
                    <Separator Style="{StaticResource OverlayMenuSeparatorStyle}" />
                    <MenuItem Header="Quit Usage Overlay"
                              Tag="Destructive"
                              Style="{StaticResource OverlayMenuItemStyle}"
                              Click="ExitMenuItem_OnClick" />
                </ContextMenu>
            </Grid.ContextMenu>

            <StackPanel Width="34" Margin="0,0,0,5" VerticalAlignment="Bottom">
                <Grid Width="14" Height="138" HorizontalAlignment="Center">
                    <Border Background="{DynamicResource OverlayTrackBrush}"
                            BorderBrush="{DynamicResource OverlayBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="7" />
                    <Border x:Name="UsageFill"
                            Margin="2"
                            CornerRadius="5"
                            RenderTransformOrigin="0.5,1">
                        <Border.Background>
                            <SolidColorBrush x:Name="UsageFillBrush" Color="{DynamicResource OverlayNormalColor}" />
                        </Border.Background>
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="UsageFillScale" ScaleY="0" />
                        </Border.RenderTransform>
                    </Border>
                    <Border x:Name="LeadingCap"
                            Width="8"
                            Height="2"
                            VerticalAlignment="Bottom"
                            Background="{DynamicResource LeadingCapBrush}"
                            CornerRadius="1"
                            Opacity="0"
                            RenderTransformOrigin="0.5,1">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="LeadingCapTranslate" Y="0" />
                        </Border.RenderTransform>
                    </Border>
                </Grid>
                <TextBlock x:Name="RailRemainingText"
                           Margin="0,4,0,0"
                           HorizontalAlignment="Center"
                           Text="--"
                           TextAlignment="Center"
                           Foreground="{DynamicResource OverlayMutedBrush}"
                           FontSize="{StaticResource OverlayTextSmall}"
                           FontWeight="Medium" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
