<Window x:Class="UsageOverlay.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Usage Overlay Settings"
        Width="650"
        Height="760"
        MinWidth="590"
        MinHeight="560"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource SettingsWindowBackgroundBrush}"
        Foreground="{DynamicResource OverlayTextBrush}"
        BorderBrush="{DynamicResource OverlayBorderBrush}"
        BorderThickness="1"
        Icon="Assets/UsageOverlay.ico"
        Loaded="Window_OnLoaded"
        SourceInitialized="Window_OnSourceInitialized"
        KeyDown="Window_OnKeyDown">
    <Window.Resources>
        <Style x:Key="SettingsTextBoxStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource OverlayTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource OverlaySurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OverlayBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="{StaticResource OverlayTextBody}" />
            <Setter Property="CaretBrush" Value="{DynamicResource OverlayTextBrush}" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource OverlayNormalBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsCheckStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource OverlayTextBrush}" />
            <Setter Property="FontSize" Value="{StaticResource OverlayTextBody}" />
            <Setter Property="Margin" Value="0,7,0,0" />
            <Setter Property="Padding" Value="2" />
        </Style>

        <Style x:Key="SettingsRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource OverlayTextBrush}" />
            <Setter Property="FontSize" Value="{StaticResource OverlayTextBody}" />
            <Setter Property="Margin" Value="0,7,0,0" />
            <Setter Property="Padding" Value="2" />
        </Style>

        <Style x:Key="SettingsButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource OverlayTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource OverlaySurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OverlayBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="FontSize" Value="{StaticResource OverlayTextBody}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource SettingsButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource SettingsButtonPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource OverlayNormalBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingsButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource OverlayNormalBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SettingsPrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OverlayNormalBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.9" />
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource OverlayTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.75" />
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource OverlayTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource OverlayTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsTitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="31" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TitleBarButtonSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TitleBarButtonSurface" Property="Background" Value="{DynamicResource OverlayMenuHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TitleBarButtonSurface" Property="Background" Value="{DynamicResource OverlaySurfaceBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TitleBarButtonSurface" Property="BorderBrush" Value="{DynamicResource OverlayTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource OverlayTextBrush}" />
            <Setter Property="FontSize" Value="{StaticResource OverlayTextValue}" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource OverlayMutedBrush}" />
            <Setter Property="FontSize" Value="{StaticResource OverlayTextSmall}" />
            <Setter Property="Margin" Value="0,10,0,5" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource OverlaySurfaceRaisedBrush}"
                BorderBrush="{DynamicResource OverlayBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Width="16" Height="16" Margin="10,0,8,0" Source="Assets/UsageOverlay.ico" />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Text="Usage Overlay Settings"
                           Foreground="{DynamicResource OverlayTextBrush}"
                           FontSize="{StaticResource OverlayTextSmall}" />
                <Button Grid.Column="2"
                        AutomationProperties.Name="Hide Settings"
                        ToolTip="Hide Settings"
                        Style="{StaticResource SettingsTitleBarButtonStyle}"
                        Click="HideSettingsButton_OnClick">
                    <Path Width="12"
                          Height="12"
                          Data="M 2,7 L 10,7"
                          Stroke="{DynamicResource OverlayMutedBrush}"
                          StrokeThickness="1.25"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />
                </Button>
                <Button Grid.Column="3"
                        AutomationProperties.Name="Close Settings"
                        ToolTip="Close Settings"
                        Style="{StaticResource SettingsTitleBarButtonStyle}"
                        Click="CloseSettingsButton_OnClick">
                    <Path Width="12"
                          Height="12"
                          Data="M 2,2 L 10,10 M 10,2 L 2,10"
                          Stroke="{DynamicResource OverlayMutedBrush}"
                          StrokeThickness="1.25"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="1" Padding="24,20" BorderBrush="{DynamicResource OverlayBorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Usage Overlay" FontSize="{StaticResource OverlayTextValue}" FontWeight="Medium" Foreground="{DynamicResource OverlayTextBrush}" />
                <TextBlock Margin="0,5,0,0"
                           Foreground="{DynamicResource OverlayMutedBrush}"
                           FontSize="{StaticResource OverlayTextBody}">
                    <Run Text="Your Codex limits at a glance. Built by " />
                    <Hyperlink NavigateUri="https://haroone.com"
                               Foreground="{DynamicResource OverlayNormalBrush}"
                               RequestNavigate="HarooneLink_OnRequestNavigate"
                               ToolTip="Open Haroone.com">
                        <Run Text="Haroone.com" />
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>

        <ScrollViewer x:Name="SettingsScrollViewer"
                      Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,16,20,20">
                <Border Margin="0,0,0,12" Padding="1" Background="{DynamicResource OverlayBorderBrush}" CornerRadius="15">
                    <Border Padding="18" Background="{DynamicResource OverlaySurfaceBrush}" CornerRadius="14">
                        <StackPanel>
                            <TextBlock Text="General" Style="{StaticResource SectionTitleStyle}" />
                            <CheckBox x:Name="StartAutomaticallyCheckBox"
                                      Content="Open when Windows starts"
                                      Style="{StaticResource SettingsCheckStyle}" />
                        </StackPanel>
                    </Border>
                </Border>

                <Border Margin="0,0,0,12" Padding="1" Background="{DynamicResource OverlayBorderBrush}" CornerRadius="15">
                    <Border Padding="18" Background="{DynamicResource OverlaySurfaceBrush}" CornerRadius="14">
                        <StackPanel>
                            <TextBlock Text="Visibility" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Margin="0,6,0,2"
                                       Text="Choose when the usage rail appears."
                                       Foreground="{DynamicResource OverlayMutedBrush}"
                                       FontSize="{StaticResource OverlayTextSmall}" />
                            <TextBlock Text="Show the rail" Style="{StaticResource FieldLabelStyle}" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="CodexOnlyVisibilityRadio"
                                             GroupName="VisibilityScope"
                                             Content="Only in Codex"
                                             Style="{StaticResource SettingsRadioStyle}" />
                                <RadioButton x:Name="AcrossWindowsVisibilityRadio"
                                             Margin="18,7,0,0"
                                             GroupName="VisibilityScope"
                                             Content="Across Windows"
                                             Style="{StaticResource SettingsRadioStyle}" />
                            </StackPanel>
                            <TextBlock Margin="0,5,0,0"
                                       Text="Across Windows keeps the rail in its last position when you switch apps."
                                       Foreground="{DynamicResource OverlayMutedBrush}"
                                       FontSize="{StaticResource OverlayTextSmall}" />
                            <CheckBox x:Name="HideFullscreenCheckBox"
                                      Content="Hide while Codex is fullscreen"
                                      Style="{StaticResource SettingsCheckStyle}" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Pause the overlay" FontSize="{StaticResource OverlayTextBody}" Foreground="{DynamicResource OverlayTextBrush}" />
                                    <TextBlock x:Name="PauseStatusText"
                                               Margin="0,3,0,0"
                                               Foreground="{DynamicResource OverlayMutedBrush}"
                                               FontSize="{StaticResource OverlayTextSmall}" />
                                </StackPanel>
                                <Button x:Name="PauseButton"
                                        Grid.Column="1"
                                        Style="{StaticResource SettingsButtonStyle}"
                                        Click="PauseButton_OnClick" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Border>

                <Border Margin="0,0,0,12" Padding="1" Background="{DynamicResource OverlayBorderBrush}" CornerRadius="15">
                    <Border Padding="18" Background="{DynamicResource OverlaySurfaceBrush}" CornerRadius="14">
                        <StackPanel>
                            <TextBlock Text="Position" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Margin="0,6,0,2"
                                       Text="Drag the rail where you want it, or snap it to an edge."
                                       Foreground="{DynamicResource OverlayMutedBrush}"
                                       FontSize="{StaticResource OverlayTextSmall}" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="RightEdgeRadio"
                                             GroupName="Position"
                                             Content="Right edge"
                                             Style="{StaticResource SettingsRadioStyle}" />
                                <RadioButton x:Name="LeftEdgeRadio"
                                             Margin="18,7,0,0"
                                             GroupName="Position"
                                             Content="Left edge"
                                             Style="{StaticResource SettingsRadioStyle}" />
                                <RadioButton x:Name="CustomPositionRadio"
                                             Margin="18,7,0,0"
                                             GroupName="Position"
                                             Content="Anywhere"
                                             Style="{StaticResource SettingsRadioStyle}" />
                            </StackPanel>
                            <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                <Button Content="← X"
                                        AutomationProperties.Name="Move left"
                                        ToolTip="Move left"
                                        Style="{StaticResource SettingsButtonStyle}"
                                        Click="MoveLeftButton_OnClick" />
                                <Button Margin="6,0,0,0"
                                        Content="X →"
                                        AutomationProperties.Name="Move right"
                                        ToolTip="Move right"
                                        Style="{StaticResource SettingsButtonStyle}"
                                        Click="MoveRightButton_OnClick" />
                                <Button Margin="6,0,0,0"
                                        Content="↑ Y"
                                        AutomationProperties.Name="Move up"
                                        ToolTip="Move up"
                                        Style="{StaticResource SettingsButtonStyle}"
                                        Click="MoveUpButton_OnClick" />
                                <Button Margin="6,0,0,0"
                                        Content="Y ↓"
                                        AutomationProperties.Name="Move down"
                                        ToolTip="Move down"
                                        Style="{StaticResource SettingsButtonStyle}"
                                        Click="MoveDownButton_OnClick" />
                                <Button Margin="6,0,0,0"
                                        Content="Reset"
                                        AutomationProperties.Name="Reset position"
                                        ToolTip="Reset position"
                                        Style="{StaticResource SettingsButtonStyle}"
                                        Click="ResetPositionButton_OnClick" />
                            </StackPanel>
                            <TextBlock x:Name="PositionOffsetText"
                                       Margin="0,7,0,0"
                                       Foreground="{DynamicResource OverlayMutedBrush}"
                                       FontSize="{StaticResource OverlayTextSmall}" />
                            <CheckBox x:Name="FollowMonitorsCheckBox"
                                      Content="Follow Codex between monitors"
                                      Style="{StaticResource SettingsCheckStyle}" />
                        </StackPanel>
                    </Border>
                </Border>

                <Border Margin="0,0,0,12" Padding="1" Background="{DynamicResource OverlayBorderBrush}" CornerRadius="15">
                    <Border Padding="18" Background="{DynamicResource OverlaySurfaceBrush}" CornerRadius="14">
                        <StackPanel>
                            <TextBlock Text="Appearance" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Theme" Style="{StaticResource FieldLabelStyle}" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="SystemThemeRadio"
                                             GroupName="ThemeMode"
                                             Content="System"
                                             Style="{StaticResource SettingsRadioStyle}"
                                             Click="ThemeRadio_OnClick" />
                                <RadioButton x:Name="DarkThemeRadio"
                                             Margin="18,7,0,0"
                                             GroupName="ThemeMode"
                                             Content="Dark"
                                             Style="{StaticResource SettingsRadioStyle}"
                                             Click="ThemeRadio_OnClick" />
                                <RadioButton x:Name="LightThemeRadio"
                                             Margin="18,7,0,0"
                                             GroupName="ThemeMode"
                                             Content="Light"
                                             Style="{StaticResource SettingsRadioStyle}"
                                             Click="ThemeRadio_OnClick" />
                            </StackPanel>
                            <TextBlock Text="Main number" Style="{StaticResource FieldLabelStyle}" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="RemainingPrimaryRadio"
                                             GroupName="PrimaryValue"
                                             Content="Left"
                                             Style="{StaticResource SettingsRadioStyle}" />
                                <RadioButton x:Name="UsedPrimaryRadio"
                                             Margin="18,7,0,0"
                                             GroupName="PrimaryValue"
                                             Content="Used"
                                             Style="{StaticResource SettingsRadioStyle}" />
                            </StackPanel>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Turn amber at (% used)" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="WarningThresholdTextBox"
                                             AutomationProperties.Name="Amber threshold percent used"
                                             Style="{StaticResource SettingsTextBoxStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Turn red at (% used)" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox x:Name="CriticalThresholdTextBox"
                                             AutomationProperties.Name="Red threshold percent used"
                                             Style="{StaticResource SettingsTextBoxStyle}" />
                                </StackPanel>
                            </Grid>
                            <Border Margin="0,12,0,2" Height="8" CornerRadius="4" Background="{DynamicResource OverlayTrackBrush}">
                                <Grid ClipToBounds="True">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="7*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{DynamicResource OverlayNormalBrush}" />
                                    <Border Grid.Column="1" Background="{DynamicResource OverlayWarningBrush}" />
                                    <Border Grid.Column="2" Background="{DynamicResource OverlayCriticalBrush}" />
                                </Grid>
                            </Border>
                            <CheckBox x:Name="AnimationsCheckBox"
                                      Content="Animate changes"
                                      Style="{StaticResource SettingsCheckStyle}" />
                            <TextBlock Margin="22,3,0,0"
                                       Text="Windows may reduce motion for accessibility."
                                       Foreground="{DynamicResource OverlayMutedBrush}"
                                       FontSize="{StaticResource OverlayTextSmall}" />
                            <CheckBox x:Name="CompactPercentageCheckBox"
                                      Content="Show the percentage below the rail"
                                      Style="{StaticResource SettingsCheckStyle}" />
                        </StackPanel>
                    </Border>
                </Border>

                <Border Padding="1" Background="{DynamicResource OverlayBorderBrush}" CornerRadius="15">
                    <Border Padding="18" Background="{DynamicResource OverlaySurfaceBrush}" CornerRadius="14">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Connection &amp; diagnostics" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Margin="0,6,0,0"
                                               Text="Only needed if Usage Overlay cannot connect or update."
                                               Foreground="{DynamicResource OverlayMutedBrush}"
                                               FontSize="{StaticResource OverlayTextSmall}" />
                                </StackPanel>
                                <Button x:Name="ConnectionToggleButton"
                                        Grid.Column="1"
                                        Content="Show details"
                                        AutomationProperties.Name="Show connection and diagnostics"
                                        Style="{StaticResource SettingsButtonStyle}"
                                        Click="ConnectionToggleButton_OnClick" />
                            </Grid>
                            <StackPanel x:Name="ConnectionSettingsPanel" Visibility="Collapsed">
                                <TextBlock Text="Codex CLI path (optional)" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="CodexCliPathTextBox"
                                         AutomationProperties.Name="Codex CLI path"
                                         Style="{StaticResource SettingsTextBoxStyle}" />
                                <TextBlock x:Name="CodexCliStatusText"
                                           Margin="0,5,0,0"
                                           Foreground="{DynamicResource OverlayMutedBrush}"
                                           FontSize="{StaticResource OverlayTextSmall}" />
                                <TextBlock Text="Refresh every (15–3600 seconds)" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="RefreshIntervalTextBox"
                                         AutomationProperties.Name="Refresh interval seconds"
                                         Style="{StaticResource SettingsTextBoxStyle}" />
                                <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                    <Button Content="Open logs" Style="{StaticResource SettingsButtonStyle}" Click="OpenLogsButton_OnClick" />
                                    <Button Margin="8,0,0,0"
                                            Content="Restore defaults"
                                            Style="{StaticResource SettingsButtonStyle}"
                                            Click="ResetAllButton_OnClick" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3" Padding="20,14" BorderBrush="{DynamicResource OverlayBorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="ValidationText"
                               Foreground="{DynamicResource OverlayCriticalBrush}"
                               FontSize="{StaticResource OverlayTextSmall}" />
                    <TextBlock x:Name="SavedStatusText"
                               Foreground="{DynamicResource OverlayNormalBrush}"
                               FontSize="{StaticResource OverlayTextSmall}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Cancel"
                            IsCancel="True"
                            Style="{StaticResource SettingsButtonStyle}"
                            Click="CancelButton_OnClick" />
                    <Button Margin="8,0,0,0"
                            Content="Save"
                            IsDefault="True"
                            Style="{StaticResource SettingsPrimaryButtonStyle}"
                            Click="SaveButton_OnClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
