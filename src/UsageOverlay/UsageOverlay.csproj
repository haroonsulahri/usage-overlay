<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\UsageOverlay.ico</ApplicationIcon>
    <AssemblyName>UsageOverlay</AssemblyName>
    <RootNamespace>UsageOverlay</RootNamespace>
    <Product>Usage Overlay</Product>
    <AssemblyTitle>Usage Overlay</AssemblyTitle>
    <Company>Haroone.com</Company>
    <Authors>Haroone.com</Authors>
    <Copyright>Copyright (c) 2026 Haroone.com</Copyright>
    <Description>Unofficial Windows usage rail for Codex, Claude and Cursor.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <StartupObject>UsageOverlay.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodexUsage.Core\CodexUsage.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\UsageOverlay.ico" />
    <Resource Include="Assets\Logos\*.png" />
  </ItemGroup>
</Project>
